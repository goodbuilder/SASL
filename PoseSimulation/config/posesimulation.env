# PoseSimulation independent application defaults.
#
# PoseSimulation is a read-only consumer of external ROS 2 interfaces.
# It does not source Simulation/config/simulation.env and does not own
# Gazebo, PX4, camera injection, mission or detector configuration.
#
# Precedence:
#   this file
#   -> optional POSESIM_PROFILE_CONFIG
#   -> explicit caller POSESIM_* environment
#   -> command-line --set overrides
#
# Units:
#   angle: degrees unless suffix is _RAD
#   position/distance: meters
#   duration/residual: milliseconds when suffix is _MS

# ---------------------------------------------------------------------------
# Application identity
# ---------------------------------------------------------------------------

POSESIM_APPLICATION_NAME=PoseSimulation
POSESIM_MODE=diagnostic_only
POSESIM_NODE_NAME=pose_simulation
POSESIM_NAMESPACE=/pose_simulation
POSESIM_READ_ONLY=true

# Source application is external and independently started.
POSESIM_SOURCE_APPLICATION=Simulation
POSESIM_START_SOURCE_APPLICATION=false
POSESIM_OWN_SOURCE_PROCESSES=false


# ---------------------------------------------------------------------------
# Source interface profile
# ---------------------------------------------------------------------------

POSESIM_SOURCE_PROFILE_ID=simulation_default_v1

# Authoritative Simulation Ground Truth candidate.
POSESIM_GT_TOPIC=/simulation/ground_truth/vehicle_reference_link
POSESIM_GT_MESSAGE_TYPE=geometry_msgs/msg/PoseStamped
POSESIM_GT_REFERENCE_NAME=vehicle_reference_link
POSESIM_GT_FALLBACK_POLICY=fail_closed

# Simulation camera optical-pose diagnostic candidates.
POSESIM_LEFT_CAMERA_POSE_TOPIC=/simulation/camera_pose_diagnostics/left
POSESIM_RIGHT_CAMERA_POSE_TOPIC=/simulation/camera_pose_diagnostics/right
POSESIM_CAMERA_POSE_MESSAGE_TYPE=std_msgs/msg/String
POSESIM_CAMERA_POSE_SCHEMA=camera_pose_comparison/v1

# Target-drone GNSS/RTK operational-reference candidate.
POSESIM_RTK_TOPIC=/fmu/out/vehicle_gps_position

# The checked-out PX4 contract documents this topic as SensorGps.  Verify the
# installed px4_msgs overlay before a live ROS run.
POSESIM_RTK_MESSAGE_TYPE=px4_msgs/msg/SensorGps

# Optional fused PX4 output is diagnostic-only and disabled by default.
POSESIM_ENABLE_FUSED_GLOBAL_DIAGNOSTIC=false
POSESIM_FUSED_GLOBAL_TOPIC=/fmu/out/vehicle_global_position
POSESIM_FUSED_GLOBAL_MESSAGE_TYPE=px4_msgs/msg/VehicleGlobalPosition


# ---------------------------------------------------------------------------
# Expected coordinate contracts
# ---------------------------------------------------------------------------

POSESIM_EXPECTED_WORLD_FRAME=gazebo_world_enu
POSESIM_EXPECTED_CAMERA_FRAME=camera_optical_rdf
POSESIM_EXPECTED_CAMERA_FORWARD_AXIS=positive_z

POSESIM_OUTPUT_FRAME=baseline_center_frd
POSESIM_OUTPUT_ORIGIN=nominal_left_right_optical_center_midpoint
POSESIM_OUTPUT_AXES=forward_right_down

POSESIM_STEREO_POLICY=parallel_rigid
POSESIM_RIG_CENTER_SOURCE=actual_optical_midpoint
POSESIM_ROLL_REFERENCE=world_up

# No alternative data is allowed to replace the source Ground Truth.
POSESIM_ALLOW_GT_FALLBACK=false
POSESIM_ALLOW_PX4_AS_GROUND_TRUTH=false
POSESIM_ALLOW_PLANNED_POSITION_AS_GROUND_TRUTH=false


# ---------------------------------------------------------------------------
# External Simulation georeference interface
# ---------------------------------------------------------------------------

# PoseSimulation does not parse a source application's SDF at runtime.
POSESIM_GEOREFERENCE_SOURCE=explicit_source_profile
POSESIM_SOURCE_WORLD_ORIENTATION=ENU
POSESIM_SOURCE_SURFACE_MODEL=EARTH_WGS84

# Current Simulation world contract, verified from the checked-out world.
POSESIM_SOURCE_ORIGIN_LATITUDE_DEG=47.397971057728974
POSESIM_SOURCE_ORIGIN_LONGITUDE_DEG=8.546163739800146
POSESIM_SOURCE_ORIGIN_ELEVATION_M=0.0
POSESIM_SOURCE_ORIGIN_ELEVATION_DATUM=gazebo_spherical_coordinates_elevation

POSESIM_GAZEBO_ORIGIN_EAST_M=0.0
POSESIM_GAZEBO_ORIGIN_NORTH_M=0.0
POSESIM_GAZEBO_ORIGIN_UP_M=0.0


# ---------------------------------------------------------------------------
# RTK altitude and comparison policy
# ---------------------------------------------------------------------------

# SensorGps exposes an MSL altitude field.  Vertical comparison remains off
# until a source-to-RTK datum conversion contract is supplied.
POSESIM_RTK_ALTITUDE_FIELD=altitude_msl_m
POSESIM_RTK_ALTITUDE_DATUM=msl
POSESIM_ENABLE_HORIZONTAL_RTK_COMPARISON=true
POSESIM_ENABLE_VERTICAL_RTK_COMPARISON=false
POSESIM_ALLOW_UNRESOLVED_VERTICAL_DATUM=false


# ---------------------------------------------------------------------------
# Physical target-point contract
# ---------------------------------------------------------------------------

POSESIM_GT_PHYSICAL_POINT=vehicle_reference_link
POSESIM_RTK_PHYSICAL_POINT=gnss_antenna_phase_center
POSESIM_TARGET_POINT_ALIGNMENT_MODE=zero_lever_arm_assumption
POSESIM_LEVER_ARM_APPLIED=false
POSESIM_LEVER_ARM_CONFIG_PATH=""
POSESIM_REQUIRE_ALIGNMENT_PROVENANCE=true


# ---------------------------------------------------------------------------
# Evaluation and time alignment
# ---------------------------------------------------------------------------

POSESIM_USE_SIM_TIME=true
POSESIM_EVALUATION_HZ=20.0
POSESIM_EVALUATION_TIME_SOURCE=gazebo_sim_time
POSESIM_TIME_ALIGNMENT_MODE=interpolate

# Engineering defaults; these are not final system-performance requirements.
POSESIM_MAX_GT_TIME_RESIDUAL_MS=25.0
POSESIM_MAX_LEFT_POSE_TIME_RESIDUAL_MS=25.0
POSESIM_MAX_RIGHT_POSE_TIME_RESIDUAL_MS=25.0
POSESIM_MAX_RTK_TIME_RESIDUAL_MS=100.0
POSESIM_MAX_INTERPOLATION_GAP_MS=250.0
POSESIM_STALE_AFTER_MS=500.0
POSESIM_ALLOW_FUTURE_EXTRAPOLATION=false
POSESIM_REJECT_OUT_OF_ORDER=true
POSESIM_REJECT_DUPLICATE_STAMPS=true


# ---------------------------------------------------------------------------
# RTK validity policy
# ---------------------------------------------------------------------------

POSESIM_ALLOW_NON_FIXED_RTK_FOR_DIAGNOSTICS=true
POSESIM_REQUIRE_RTK_FIXED_FOR_OPERATIONAL=true

# An empty value is unresolved and therefore fail-closed for operational use.
POSESIM_RTK_FIXED_STATUS_VALUES=""
POSESIM_RTK_MAX_EPH_M=""
POSESIM_RTK_MAX_EPV_M=""
POSESIM_RTK_MAX_HORIZONTAL_JUMP_M=""
POSESIM_RTK_MAX_VERTICAL_JUMP_M=""
POSESIM_RTK_MAX_SOURCE_AGE_MS=500.0


# ---------------------------------------------------------------------------
# PoseSimulation output topics
# ---------------------------------------------------------------------------

POSESIM_POSE_ERROR_TOPIC=/pose_simulation/pose_error
POSESIM_STEREO_GEOMETRY_TOPIC=/pose_simulation/stereo_geometry
POSESIM_STATUS_TOPIC=/pose_simulation/status
POSESIM_GT_IDEAL_POSE_TOPIC=/pose_simulation/ideal_pose/ground_truth
POSESIM_RTK_IDEAL_POSE_TOPIC=/pose_simulation/ideal_pose/rtk
POSESIM_DIAGNOSTICS_TOPIC=/pose_simulation/diagnostics
POSESIM_MARKER_TOPIC=/pose_simulation/visualization/markers


# ---------------------------------------------------------------------------
# Recording
# ---------------------------------------------------------------------------

POSESIM_ENABLE_RECORDING=false
POSESIM_OUTPUT_DIR=""
POSESIM_RECORD_FORMAT=jsonl
POSESIM_RECORD_PROVENANCE=true
POSESIM_RECORD_INPUT_MESSAGES=false


# ---------------------------------------------------------------------------
# rqt defaults
# ---------------------------------------------------------------------------

POSESIM_START_RQT=true
POSESIM_TREND_WINDOW_S=30.0
POSESIM_TREND_BUFFER_S=120.0

# Empty threshold means UNSPECIFIED, not PASS and not FAIL.
POSESIM_WARN_RELATIVE_YAW_ERROR_DEG=""
POSESIM_FAIL_RELATIVE_YAW_ERROR_DEG=""
POSESIM_WARN_OPTICAL_AXIS_ERROR_DEG=""
POSESIM_FAIL_OPTICAL_AXIS_ERROR_DEG=""
POSESIM_WARN_BASELINE_LENGTH_ERROR_M=""
POSESIM_FAIL_BASELINE_LENGTH_ERROR_M=""
POSESIM_WARN_BASELINE_DIRECTION_ERROR_DEG=""
POSESIM_FAIL_BASELINE_DIRECTION_ERROR_DEG=""
POSESIM_WARN_RTK_LOS_ERROR_DEG=""
POSESIM_FAIL_RTK_LOS_ERROR_DEG=""


# ---------------------------------------------------------------------------
# RViz defaults
# ---------------------------------------------------------------------------

POSESIM_START_RVIZ=true
POSESIM_RVIZ_FIXED_FRAME=gazebo_world_enu
POSESIM_RVIZ_RAY_MODE=normalized
POSESIM_RVIZ_RAY_LENGTH_M=50.0
POSESIM_RVIZ_MARKER_LIFETIME_S=0.5
POSESIM_RVIZ_SHOW_ACTUAL=true
POSESIM_RVIZ_SHOW_GT_IDEAL=true
POSESIM_RVIZ_SHOW_RTK_IDEAL=false
POSESIM_RVIZ_SHOW_GT_LOS=true
POSESIM_RVIZ_SHOW_RTK_LOS=false
POSESIM_RVIZ_SHOW_ERROR_ARCS=true
POSESIM_RVIZ_SHOW_TEXT=true
