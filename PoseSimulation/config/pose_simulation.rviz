Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World Grid
      Normal Cell Count: 0
      Offset: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Name: Authoritative TF
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /pose_simulation/visualization/markers
      Name: PoseSimulation Diagnostics
      Namespaces:
        pose_sim/actual/left: true
        pose_sim/actual/right: true
        pose_sim/actual/rig: true
        pose_sim/baseline/actual: true
        pose_sim/baseline/ideal_gt: true
        pose_sim/baseline/ideal_rtk: false
        pose_sim/error/left: true
        pose_sim/error/right: true
        pose_sim/error/relative: true
        pose_sim/ideal_gt/left: true
        pose_sim/ideal_gt/right: true
        pose_sim/ideal_gt/rig: true
        pose_sim/ideal_rtk/left: false
        pose_sim/ideal_rtk/right: false
        pose_sim/ideal_rtk/rig: false
        pose_sim/rays/actual: true
        pose_sim/rays/gt_los: true
        pose_sim/rays/rtk_los: false
        pose_sim/target/gt: true
        pose_sim/target/rtk: false
        pose_sim/target/rtk_gt_error: false
        pose_sim/text: true
      Queue Size: 10
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: gazebo_world_enu
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 100
      Focal Point: 0; 0; 0
      Name: Current View
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Yaw: 0.5
Window Geometry:
  Height: 900
  Width: 1400
