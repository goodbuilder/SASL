# Protocol v1.1 physical camera group G0. Load after simulation.env with
# SIM_SCENARIO_CONFIG=config/campaign/v1_1/G0.env.
# World ENU camera centers are (-12.5,0,0.1) and (12.5,0,0.1) m.
# Existing CAM_*_OPTICAL_* inputs are local optical RDF roll/right-axis
# pitch/down-axis yaw in degrees. At roll=0, pitch=20 deg and yaw=0,
# the rendered R_WC equals protocol R_WC_nominal. PX4 body attitude is separate.
SIM_SCENARIO_NAME=stereo_campaign_v1_1_G0
CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=0.1
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=20.0
CAM_L_OPTICAL_ROLL_DEG=0.0
CAM_L_OPTICAL_PITCH_DEG=20.0
CAM_L_OPTICAL_YAW_DEG=0.0
CAM_R_OPTICAL_ROLL_DEG=0.0
CAM_R_OPTICAL_PITCH_DEG=20.0
CAM_R_OPTICAL_YAW_DEG=0.0
COMMON_OPTICAL_ROLL_ERROR_DEG=0.0
COMMON_OPTICAL_PITCH_ERROR_DEG=0.0
COMMON_OPTICAL_YAW_ERROR_DEG=0.0
RELATIVE_OPTICAL_ROLL_ERROR_DEG=0.0
RELATIVE_OPTICAL_PITCH_ERROR_DEG=0.0
RELATIVE_OPTICAL_YAW_ERROR_DEG=0.0
