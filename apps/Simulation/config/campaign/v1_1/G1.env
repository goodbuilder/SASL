# Protocol v1.1 physical camera group G1. Load after simulation.env with
# SIM_SCENARIO_CONFIG=config/campaign/v1_1/G1.env.
# World ENU camera centers remain (-12.5,0,0.1) and (12.5,0,0.1) m.
# The existing local optical-RDF composition is R_Down(yaw) @ R_Right(pitch)
# at zero roll. For this fixed 20 deg pitch, its yaw +0.5/-0.5 deg produces
# protocol Rz_world(-psi) @ R_WC_nominal with north-to-east psi +0.5/-0.5 deg.
# This equivalence is checked against the generated SDF, not assumed for
# arbitrary legacy roll/pitch/yaw records. PX4 body attitude is separate.
SIM_SCENARIO_NAME=stereo_campaign_v1_1_G1
CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=0.1
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=20.0
CAM_L_OPTICAL_ROLL_DEG=0.0
CAM_L_OPTICAL_PITCH_DEG=20.0
CAM_L_OPTICAL_YAW_DEG=0.5
CAM_R_OPTICAL_ROLL_DEG=0.0
CAM_R_OPTICAL_PITCH_DEG=20.0
CAM_R_OPTICAL_YAW_DEG=-0.5
COMMON_OPTICAL_ROLL_ERROR_DEG=0.0
COMMON_OPTICAL_PITCH_ERROR_DEG=0.0
COMMON_OPTICAL_YAW_ERROR_DEG=0.0
RELATIVE_OPTICAL_ROLL_ERROR_DEG=0.0
RELATIVE_OPTICAL_PITCH_ERROR_DEG=0.0
RELATIVE_OPTICAL_YAW_ERROR_DEG=0.0
