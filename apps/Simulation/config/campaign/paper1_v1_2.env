# v1.2 raw collection. The XLSX is the only campaign-condition input.
# Shell launchers define ROOT_DIR as apps/Simulation before loading config.
source "$ROOT_DIR/config/simulation.env"
STEREO_V1_1_ACTION=xlsx_all
STEREO_V1_1_OUTPUT_ID=paper1_v1_2_001
STEREO_V1_1_OUTPUT_BASE=repo
STEREO_V1_1_WORKBOOK=config/campaign/v1_1/sweep_manifest_v1_1.xlsx
STEREO_V1_1_PX4_DIR=PX4-Autopilot
STEREO_V1_1_YOLO_PYTHON=.venv/bin/python
YOLO_DEVICE=cuda:0
YOLO_TORCH_BACKEND=cuda
