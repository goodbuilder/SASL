# Normal-launch precedence: caller environment > scenario profile > this file.
# Angles are degrees; positions, distances, and altitudes are meters.
# CAM_*_OPTICAL_* is OpenCV optical RDF; CAM_*_PX4_ATTITUDE_* is PX4 body FRD.
# Workflow ownership:
# - xlsx_* reads run conditions from the manifest; this file keeps shared
#   defaults and fixed runtime connections.
# - SWEEP_* belongs only to run_auto_attitude_sweep.sh --legacy.
# - DRONE_*, AUTO_*, and WAYPOINT_* serve the mission and legacy operator flows.
# - Generic YOLO settings serve operator flows; xlsx_* uses Capture and its
#   pinned model manifest.
# - STEREO_V1_1_MC_TRIALS applies only to fixed-protocol analysis, not xlsx_*.

# Human-operated stereo campaign v1.1 controls. The standalone RQT campaign
# panel reads these as literal values and rereads them when Refresh is clicked.
# STEREO_V1_1_RUN_ID is for fixed single-run actions; xlsx_* uses RunManifest.
# STEREO_V1_1_WORKBOOK selects the ordered manifest; it owns each parameter's
# fixed/run-variable scope and value.
# The legacy attitude sweep is available only through --legacy.
STEREO_V1_1_ACTION=xlsx_plan
STEREO_V1_1_RUN_ID=G0-P0-R01
STEREO_V1_1_OUTPUT_ID=campaign_001
STEREO_V1_1_OUTPUT_BASE=repo
STEREO_V1_1_INPUT_ROOT=output
STEREO_V1_1_WORKBOOK=config/campaign/v1_1/sweep_manifest_v1_1.xlsx
# Offline-analysis trial count for fixed-protocol resume/all_results/reprocess.
# The xlsx_* flight actions do not read this value; their OfflinePlan is handoff metadata.
STEREO_V1_1_MC_TRIALS=100
STEREO_V1_1_PX4_DIR=PX4-Autopilot
STEREO_V1_1_YOLO_PYTHON=.venv/bin/python

# Stereo camera model.
CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=0.1
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=20.0
# Optional overlay publication is a display rate, separate from camera capture.
OVERLAY_PUBLISH_HZ=20.0
CAMERA_CLIP_NEAR_M=0.1
CAMERA_CLIP_FAR_M=500.0

# Optical attitude (OpenCV RDF).
CAM_L_OPTICAL_ROLL_DEG=0.0
CAM_L_OPTICAL_PITCH_DEG=8.0
CAM_L_OPTICAL_YAW_DEG=0.0
CAM_R_OPTICAL_ROLL_DEG=0.0
CAM_R_OPTICAL_PITCH_DEG=8.0
CAM_R_OPTICAL_YAW_DEG=0.0

# Fixed PX4 body attitude (FRD), independent of optical attitude.
CAM_L_PX4_ATTITUDE_ROLL_DEG=0.0
CAM_L_PX4_ATTITUDE_PITCH_DEG=8.0
CAM_L_PX4_ATTITUDE_YAW_DEG=0.0
CAM_R_PX4_ATTITUDE_ROLL_DEG=0.0
CAM_R_PX4_ATTITUDE_PITCH_DEG=8.0
CAM_R_PX4_ATTITUDE_YAW_DEG=0.0

# Rig calibration: known angle from the left->right GNSS baseline bearing to
# each camera's own optical Forward bearing (attitude_true_north Ray). For
# this parallel (non-toed-in) stereo rig, Forward points 90 deg CCW of the
# baseline (which runs along body Right), hence -90.0 for both sides.
CAM_L_GNSS_BASELINE_TO_FORWARD_YAW_DEG=-90.0
CAM_R_GNSS_BASELINE_TO_FORWARD_YAW_DEG=-90.0

# Magnetometer noise/bias [G], body FRD X/Y/Z = Forward/Right/Down.
CAM_L_MAG_NOISE_X_GAUSS=0.000001
CAM_L_MAG_NOISE_Y_GAUSS=0.000001
CAM_L_MAG_NOISE_Z_GAUSS=0.000001
CAM_L_MAG_BIAS_MEAN_X_GAUSS=0.0
CAM_L_MAG_BIAS_MEAN_Y_GAUSS=0.0
CAM_L_MAG_BIAS_MEAN_Z_GAUSS=0.0
CAM_L_MAG_BIAS_STDDEV_X_GAUSS=0.0
CAM_L_MAG_BIAS_STDDEV_Y_GAUSS=0.0
CAM_L_MAG_BIAS_STDDEV_Z_GAUSS=0.0
CAM_R_MAG_NOISE_X_GAUSS=0.000001
CAM_R_MAG_NOISE_Y_GAUSS=0.000001
CAM_R_MAG_NOISE_Z_GAUSS=0.000001
CAM_R_MAG_BIAS_MEAN_X_GAUSS=0.0
CAM_R_MAG_BIAS_MEAN_Y_GAUSS=0.0
CAM_R_MAG_BIAS_MEAN_Z_GAUSS=0.0
CAM_R_MAG_BIAS_STDDEV_X_GAUSS=0.0
CAM_R_MAG_BIAS_STDDEV_Y_GAUSS=0.0
CAM_R_MAG_BIAS_STDDEV_Z_GAUSS=0.0

# Gyroscope noise/bias [rad/s], body FRD X/Y/Z = Forward/Right/Down.
CAM_L_GYRO_NOISE_X_RAD_S=0.00001
CAM_L_GYRO_NOISE_Y_RAD_S=0.00001
CAM_L_GYRO_NOISE_Z_RAD_S=0.00001
CAM_L_GYRO_BIAS_MEAN_X_RAD_S=0.0
CAM_L_GYRO_BIAS_MEAN_Y_RAD_S=0.0
CAM_L_GYRO_BIAS_MEAN_Z_RAD_S=0.0
CAM_L_GYRO_BIAS_STDDEV_X_RAD_S=0.0
CAM_L_GYRO_BIAS_STDDEV_Y_RAD_S=0.0
CAM_L_GYRO_BIAS_STDDEV_Z_RAD_S=0.0
CAM_R_GYRO_NOISE_X_RAD_S=0.00001
CAM_R_GYRO_NOISE_Y_RAD_S=0.00001
CAM_R_GYRO_NOISE_Z_RAD_S=0.00001
CAM_R_GYRO_BIAS_MEAN_X_RAD_S=0.0
CAM_R_GYRO_BIAS_MEAN_Y_RAD_S=0.0
CAM_R_GYRO_BIAS_MEAN_Z_RAD_S=0.0
CAM_R_GYRO_BIAS_STDDEV_X_RAD_S=0.0
CAM_R_GYRO_BIAS_STDDEV_Y_RAD_S=0.0
CAM_R_GYRO_BIAS_STDDEV_Z_RAD_S=0.0

# PX4 GPS baseline triangulation.
ENABLE_GPS_BASELINE_TRIANGULATION=true
GPS_BASELINE_SOURCE=both
GPS_BASELINE_MAX_AGE_S=0.2

# Simulated visible-satellite count per camera Pixhawk (PX4 parameter
# SIM_GPS_USED, set in vendor/px4_camera_airframe/4090_camera_px4). PX4's
# SITL GPS driver only reports a 3D fix (fix_type=3) when this is >= 4;
# below that it reports fix_type=0 with eph=epv=100, letting you simulate a
# GPS dropout on one or both cameras and see how the GNSS-baseline-derived
# Rays (attitude_true_north/operational_true_north/attitude_declination)
# fail closed. Default 10 preserves the previous always-fix behavior.
CAM_L_SIM_GPS_USED=10
CAM_R_SIM_GPS_USED=10

# NOT configurable here: when SIM_GPS_USED >= 4, PX4's simulated eph/epv are
# a fixed 0.9m / 1.78m -- not derived from any noise magnitude, and not a
# PX4 parameter. They (and the underlying lat/lon/alt noise added to the
# simulated fix) are hardcoded literals in PX4-Autopilot itself:
#   src/modules/simulation/sensor_egps_sim/SensorGpsSim.cpp
#     latitude/longitude noise:  generate_wgn() * 0.2 / CONSTANTS_RADIUS_OF_EARTH
#     altitude noise:            generate_wgn() * 0.5f
#     eph/epv (fix_type=3):      0.9f / 1.78f
#     eph/epv (fix_type=0):      100.f / 100.f
# Making these env-configurable like CAM_L_MAG_NOISE_* would need patching
# that file to read new PX4 parameters and rebuilding PX4 SITL -- a
# firmware-level change, not a launch-arg/SDF-template one.

# Camera PX4 instances; target remains instance 0 on /fmu.
PX4_REQUIRED_VERSION=v1.17.0
CAM_L_PX4_MODEL_NAME=left_stereo_camera
CAM_R_PX4_MODEL_NAME=right_stereo_camera
CAM_L_PX4_INSTANCE=1
CAM_R_PX4_INSTANCE=2
CAM_L_PX4_DDS_NAMESPACE=camera_left
CAM_R_PX4_DDS_NAMESPACE=camera_right
PX4_ATTITUDE_LEFT_TOPIC=/camera_left/fmu/out/vehicle_attitude
PX4_ATTITUDE_RIGHT_TOPIC=/camera_right/fmu/out/vehicle_attitude
PX4_ATTITUDE_MAX_AGE_S=0.2
PX4_ATTITUDE_PAIR_SKEW_S=0.2

# Legacy auto-attitude sweep (--legacy only): two trajectories x one baseline
# plus nine OFAT cases.
SWEEP_AXES="roll,pitch,yaw"
SWEEP_VALUES_DEG="0.2,0.5,1.0"
SWEEP_REPETITIONS=1
SWEEP_TRAJECTORIES="center,zigzag"
SWEEP_WAYPOINT_COUNT=8
SWEEP_WAYPOINT_HOLD_S=5.0
SWEEP_FINAL_HOVER_S=0.0
# baseline-center world-aligned Right,Front,Up [m], far-to-near.
SWEEP_WAYPOINTS_RFU_M="0,415,154;0,365,137;0,315,121;0,265,104;0,215,88;0,165,71;0,115,55;0,65,38"
# Zigzag uses this fraction of the nominal horizontal stereo-overlap half-width.
SWEEP_ZIGZAG_OVERLAP_RATIO=0.40
SWEEP_PIXEL_MARGIN_PX=32.0
SWEEP_ENTRY_MIN_WORLD_FRONT_M=400.0
# false records telemetry and both overlay MP4s from the first published frame.
SWEEP_RECORD_WAIT_FOR_BBOX=false
SWEEP_STABILITY_WINDOW_S=3.0
SWEEP_STABILITY_POSITION_P95_MAX_M=1.0
SWEEP_STABILITY_ATTITUDE_MAX_DEG=15.0
# Transit uses velocity-only local-NED guidance so the distant final position
# cannot saturate PX4's position P-controller at its 12/5 m/s global limits.
# Required waypoint holds remain position-only.
SWEEP_GUIDANCE_MODE=velocity_only
SWEEP_OUTPUT_DIR=""
SWEEP_WAIT_S=120
SWEEP_CAMERA_UPDATE_RATE_HZ=20.0
SWEEP_YOLO_TARGET_HZ=20.0
SWEEP_OVERLAY_PUBLISH_HZ=20.0
# New sweep cases must prove sustained rates from recorded evidence after warmup.
SWEEP_PERFORMANCE_WARMUP_S=15.0
SWEEP_PERFORMANCE_MIN_STEADY_S=10.0
SWEEP_MIN_YOLO_UPDATE_HZ=15.0
SWEEP_MAX_YOLO_INFERENCE_P95_MS=66.7
SWEEP_MIN_OVERLAY_HZ=15.0
SWEEP_BASELINE_ONLY=false
SWEEP_SEED=20260825
SWEEP_RANDOMIZE=false
SWEEP_SKIP_COLCON_BUILD=false
SWEEP_KEEP_GOING=true
SWEEP_FORCE_EXISTING_SIM=false

# General target-drone mission defaults. xlsx_* reads spawn and path conditions
# from the workbook.
PX4_GZ_MODEL_NAME=x500_2m
DRONE_SPAWN_X_M=0.0
DRONE_SPAWN_Y_M=415.0
DRONE_SPAWN_Z_M=6.0
DRONE_SPAWN_YAW_DEG=-90.0
DRONE_TAKEOFF_ALTITUDE_M=5.0
DRONE_FORWARD_SPEED_MPS=2.0
DRONE_MOVE_DISTANCE_M=350.0
DRONE_TARGET_DISTANCE_M=65.0
DRONE_APPROACH_TIMEOUT_S=400.0
DRONE_TAKEOFF_TIMEOUT_S=60.0
DRONE_FIRST_HOVER_S=5.0
DRONE_FINAL_HOVER_S=5.0
DRONE_LAND_DURATION_S=10.0
DRONE_LAND_TIMEOUT_S=90.0
DRONE_SETPOINT_HZ=20.0

# FOV-guarded Auto mission.
AUTO_FOV_MARGIN_RATIO=0.05
AUTO_FOV_DETECTION_TIMEOUT_S=0.5
AUTO_FOV_DETECTIONS_TOPIC=/stereo/live_detections
# Auto-generated waypoints sit on the FOV boresight (dead centre, not
# scattered) and step inward along Front/range by this amount; point count is
# derived from DRONE_SPAWN_Y_M -> DRONE_SPAWN_Y_M - DRONE_MOVE_DISTANCE_M
# divided by this spacing. Set to 0 to fall back to AUTO_WAYPOINT_COUNT random
# FOV scatter instead.
AUTO_WAYPOINT_RANGE_STEP_M=5.0
AUTO_WAYPOINT_COUNT=8

# Absolute PX4 local-NED waypoints: north,east,altitude_agl_m[,hold_s];...
# altitude_agl_m is converted to local-NED Down internally. An optional 4th
# field overrides WAYPOINT_HOLD_S for that one waypoint; omit it to hover
# for the usual WAYPOINT_HOLD_S at that point.
#
# Original 30m-spaced straight-line approach (400m->200m, target stays on
# the 20 deg pitch boresight the whole way), one hover per waypoint:
# WAYPOINTS_XY_ALT_M="0,0,145.6;-30,0,134.7;-60,0,123.7;-90,0,112.8;-120,0,101.9;-150,0,91.0;-175,0,81.9;-200,0,72.8"
# Left-right zigzag variant of the above (same north/altitude glide
# schedule; east alternates +-2.0m, verified to stay inside the safe FOV
# margin -- 5% inset from both image edges -- for both cameras at every
# point, including the tightest baseline-parallax margin at the 200m
# closest waypoint):
# WAYPOINTS_XY_ALT_M="0,2.0,145.6;-30,-2.0,134.7;-60,2.0,123.7;-90,-2.0,112.8;-120,2.0,101.9;-150,-2.0,91.0;-175,2.0,81.9;-200,-2.0,72.8"
#
# Current default: same straight-line glide schedule at 5m spacing (41
# waypoints), hovering only at the original 8 checkpoints (the other 33
# pass through with hold_s=0). Long high-speed 30m legs let the vehicle's
# horizontal response (needs to build a tilt angle) lag behind its near-
# instant vertical (thrust-only) response for long enough to drift ~4-6m
# off the intended glide line; splitting each leg into short 5m hops never
# gives that lag time to build up. Measured (live flight, MPC_TILTMAX_AIR
# overridden to 45 deg): worst-case deviation from the glide line dropped
# from ~4.3-5.8m (30m spacing) to 1.91m (5m spacing), mean ~0.98m.
WAYPOINTS_XY_ALT_M="0,0,145.60;-5,0,143.78,0;-10,0,141.96,0;-15,0,140.14,0;-20,0,138.32,0;-25,0,136.50,0;-30,0,134.68;-35,0,132.86,0;-40,0,131.04,0;-45,0,129.22,0;-50,0,127.40,0;-55,0,125.58,0;-60,0,123.76;-65,0,121.94,0;-70,0,120.12,0;-75,0,118.30,0;-80,0,116.48,0;-85,0,114.66,0;-90,0,112.84;-95,0,111.02,0;-100,0,109.20,0;-105,0,107.38,0;-110,0,105.56,0;-115,0,103.74,0;-120,0,101.92;-125,0,100.10,0;-130,0,98.28,0;-135,0,96.46,0;-140,0,94.64,0;-145,0,92.82,0;-150,0,91.00;-155,0,89.18,0;-160,0,87.36,0;-165,0,85.54,0;-170,0,83.72,0;-175,0,81.90;-180,0,80.08,0;-185,0,78.26,0;-190,0,76.44,0;-195,0,74.62,0;-200,0,72.80"
WAYPOINT_SPEED_MPS=2.0
WAYPOINT_ACCEPTANCE_RADIUS_M=0.5
WAYPOINT_TIMEOUT_S="${DRONE_APPROACH_TIMEOUT_S:-300.0}"
# Hover time at each waypoint / after the final waypoint, in seconds.
# Set to 0 to fly through waypoints without hovering.
WAYPOINT_HOLD_S=5.0
# Time to accelerate/decelerate horizontal/vertical speed at the start/end
# of a leg (e.g. right after a hold ends), in seconds. 0 disables ramping.
# Vertical is kept longer than horizontal: the vehicle's real Z response is
# near-instant (thrust only) but horizontal needs to build a tilt angle
# first, so ramping both on the same schedule still lets altitude outrun
# horizontal position.
WAYPOINT_RAMP_S=1.0
WAYPOINT_VERTICAL_RAMP_S=2.5
WAYPOINT_FINAL_HOVER_S="${DRONE_FINAL_HOVER_S:-3.0}"
WAYPOINT_LAND_TIMEOUT_S="${DRONE_LAND_TIMEOUT_S:-90.0}"
WAYPOINT_SETPOINT_HZ="${DRONE_SETPOINT_HZ:-20.0}"
# Mission-time PX4 vertical speed limits [m/s].
WAYPOINT_MPC_Z_VEL_MAX_UP_MPS=5.0
WAYPOINT_MPC_Z_VEL_MAX_DN_MPS=5.0
# Raised from the PX4 default's original 20 deg: faster horizontal tilt
# response cut the glide-line overshoot from ~6.75m to ~4.1m before the
# waypoint spacing above was densified, and it's the tiltmax the densified
# spacing (1.91m worst-case deviation) was measured under.
WAYPOINT_MPC_TILTMAX_AIR_DEG=45.0
WAYPOINT_LAND_AFTER=false
# With WAYPOINT_LAND_AFTER=false: exit automatically once WAYPOINT_FINAL_HOVER_S
# elapses instead of hovering indefinitely until interrupted (Ctrl+C).
WAYPOINT_STOP_AFTER_HOVER=true
WAYPOINT_RECORD_FULL=true
WAYPOINT_RECORD_DIR=""

# General operator YOLO runtime defaults. xlsx_* uses Capture values and the
# pinned campaign model manifest.
YOLO_MODEL_PATH="yolov8n_uav.pt"
YOLO_CLASS_NAME=UAV
YOLO_CONFIDENCE=0.10
YOLO_DEVICE=cuda:0
YOLO_ALLOW_CPU_FALLBACK=false
YOLO_TARGET_HZ=20.0
YOLO_IMGSZ=736
YOLO_BACKEND=pytorch
YOLO_TENSORRT_ENGINE_PATH=""
MEASUREMENT_QUEUE_CAPACITY=4096
YOLO_PYTHON=python3
YOLO_VENV_ISOLATED=true
YOLO_TORCH_BACKEND=cuda
YOLO_TORCH_CUDA_INDEX_URL="https://download.pytorch.org/whl/cu132"
YOLO_TORCH_VERSION=2.12.0
YOLO_TORCHVISION_VERSION=0.27.0
# YOLO does not use torchaudio, and the official cu132 index has no matching wheel.
YOLO_TORCHAUDIO_VERSION=""
YOLO_ULTRALYTICS_VERSION=8.4.127
