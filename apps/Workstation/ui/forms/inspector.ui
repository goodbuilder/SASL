      <item row="0" column="1">
       <widget class="QComboBox" name="mountain_margin_combo">
        <property name="styleObjectName" stdset="0">
         <string>inspectorMountainRidgeMargin</string>
        </property>
        <property name="toolTip">
         <string>How close a matched point must be to Mountain's estimated ridge/skyline
boundary to be kept, as a fraction of image height. Wider keeps more
matches but risks drifting off the ridge; narrower is stricter but can
drop legitimate points on a jagged silhouette. Takes effect on the next
Auto-select Mountain run, not live.</string>
        </property>
        <property name="optionValues" stdset="0">
         <string>[0.02, 0.04, 0.06, 0.08, 0.1, 0.12, 0.15]</string>
        </property>
        <item>
         <property name="text">
          <string>2%</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>4%</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>6%  (default)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>8%</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>10%</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>12%</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>15%</string>
         </property>
        </item>
       </widget>
