      <item row="1" column="1">
       <widget class="QComboBox" name="mountain_max_points_combo">
        <property name="styleObjectName" stdset="0">
         <string>inspectorMountainMaxPoints</string>
        </property>
        <property name="toolTip">
         <string>How many spatially-spread correspondences Mountain/Cloud keep for
the final suggestion. 'All inliers' stores and shows every match
that passes RANSAC (complete evidence for the relative-rotation
fit); a number caps the overlay to that many spread points.
Takes effect on the next Auto-select run, not live.</string>
        </property>
        <property name="optionValues" stdset="0">
         <string>[0, 4, 8, 12, 16, 20, 30, 40, 80, 200]</string>
        </property>
        <item>
         <property name="text">
          <string>All inliers  (default)</string>
         </property>
        </item>
        <item>
