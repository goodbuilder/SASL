+++ b/src/drivers/uavcan/sensors/mag.cpp
@@ -52,6 +52,27 @@ UavcanMagnetometerBridge::UavcanMagnetometerBridge(uavcan::INode &node, NodeInfo
 	set_device_type(DRV_MAG_DEVTYPE_UAVCAN);
 }
 
+void UavcanMagnetometerBridge::publish_sasl_can_mag(uint8_t iface_index, uint8_t node_id, uint32_t device_id,
+		hrt_abstime timestamp_sample, float xmag, float ymag, float zmag)
+{
+	struct sasl_can_mag_s sample {};
+	sample.timestamp_sample = timestamp_sample;
+	sample.device_id = device_id;
+	sample.can_port = (iface_index == 0) ? 1 : 2; // iface 0 = CAN1, iface 1 = CAN2
+	sample.node_id = node_id;
+	sample.xmag = xmag;
+	sample.ymag = ymag;
+	sample.zmag = zmag;
+	sample.timestamp = hrt_absolute_time();
+
+	if (_sasl_can_mag_pub == nullptr) {
+		_sasl_can_mag_pub = orb_advertise(ORB_ID(sasl_can_mag), &sample);
+
+	} else {
+		orb_publish(ORB_ID(sasl_can_mag), _sasl_can_mag_pub, &sample);
+	}
+}
