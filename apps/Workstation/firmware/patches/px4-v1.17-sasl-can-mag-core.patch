@@ -0,0 +1,19 @@
+# SASL telemetry-only message: per-CAN-port DroneCAN (UAVCAN) magnetometer
+# reading, published in parallel to (never instead of) sensor_mag. This topic
+# feeds only the SASL_CAN_MAG MAVLink stream; it is not consumed by EKF2.
+#
+# xmag/ymag/zmag are the exact same raw sensor-frame vector handed to
+# PX4Magnetometer::update() by the UAVCAN mag driver (ROTATION_NONE is used
+# for CAN magnetometers there) -- Gauss, not rotated into FRD/NED/board frame.
+
+uint64 timestamp          # time since system start (microseconds), publish time
+uint64 timestamp_sample   # time the CAN frame was received (microseconds)
+
+uint32 device_id          # PX4 device id of the magnetometer driver instance
+
+uint8 can_port             # physical CAN bus the sample arrived on: 1 = CAN1, 2 = CAN2
+uint8 node_id               # DroneCAN node ID of the magnetometer
+
+float32 xmag               # magnetic field X, sensor frame, Gauss
+float32 ymag               # magnetic field Y, sensor frame, Gauss
+float32 zmag               # magnetic field Z, sensor frame, Gauss
