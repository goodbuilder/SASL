+// SASL private MAVLink stream: forwards the sasl_can_mag uORB topic (per-CAN-port
+// DroneCAN magnetometer telemetry) unchanged; does not touch sensor_mag/EKF.
+
+#ifndef SASL_CAN_MAG_HPP
+#define SASL_CAN_MAG_HPP
+
+#include <uORB/topics/sasl_can_mag.h>
+
+class MavlinkStreamSaslCanMag : public MavlinkStream
+{
+public:
+	static MavlinkStream *new_instance(Mavlink *mavlink) { return new MavlinkStreamSaslCanMag(mavlink); }
+
+	static constexpr const char *get_name_static() { return "SASL_CAN_MAG"; }
+	static constexpr uint16_t get_id_static() { return MAVLINK_MSG_ID_SASL_CAN_MAG; }
+
+	const char *get_name() const override { return get_name_static(); }
+	uint16_t get_id() override { return get_id_static(); }
+
+	unsigned get_size() override
+	{
+		return _sasl_can_mag_sub.advertised() ? MAVLINK_MSG_ID_SASL_CAN_MAG_LEN + MAVLINK_NUM_NON_PAYLOAD_BYTES : 0;
+	}
+
+private:
+	explicit MavlinkStreamSaslCanMag(Mavlink *mavlink) : MavlinkStream(mavlink) {}
+
+	uORB::Subscription _sasl_can_mag_sub{ORB_ID(sasl_can_mag)};
+
+	bool send() override
+	{
+		sasl_can_mag_s sample;
+
+		if (_sasl_can_mag_sub.update(&sample)) {
+			mavlink_sasl_can_mag_t msg{};
+			msg.time_usec = sample.timestamp_sample;
+			msg.device_id = sample.device_id;
+			msg.can_port = sample.can_port;
+			msg.node_id = sample.node_id;
+			msg.xmag = sample.xmag;
+			msg.ymag = sample.ymag;
+			msg.zmag = sample.zmag;
+
+			mavlink_msg_sasl_can_mag_send_struct(_mavlink->get_channel(), &msg);
+
+			return true;
+		}
+
+		return false;
+	}
+};
+
+#endif // SASL_CAN_MAG_HPP
