# Canonical Simulation defaults shared by every runner.
#
# Precedence:
#   explicit caller environment > optional scenario profile > this file
#
# Angle unit: degrees. Position/distance/altitude unit: meters.
# Camera optical and Camera PX4 attitudes are independent absolute errors from
# the nominal stereo-rig orientation. They are composed only in the generated
# SDF through the fixed base_link -> optical_link transform.

# Stereo camera model.
CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=1.0
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=20.0
CAMERA_CLIP_NEAR_M=0.1
CAMERA_CLIP_FAR_M=2500.0

# Simulation-only parallel triangulation: raw PX4 GPS camera baseline.  This
# isolates baseline error from unknown common GPS translation.
ENABLE_GPS_BASELINE_TRIANGULATION=true
GPS_BASELINE_SOURCE=both
GPS_BASELINE_MAX_AGE_S=2.5

# Left/right optical attitudes (OpenCV optical RDF convention).
CAM_L_OPTICAL_ROLL_DEG=0.0
CAM_L_OPTICAL_PITCH_DEG=2.0
CAM_L_OPTICAL_YAW_DEG=0.0
CAM_R_OPTICAL_ROLL_DEG=0.0
CAM_R_OPTICAL_PITCH_DEG=2.0
CAM_R_OPTICAL_YAW_DEG=-0.0

# Left/right Camera PX4 body attitudes (PX4 FRD convention).
CAM_L_PX4_ROLL_DEG=0.0
CAM_L_PX4_PITCH_DEG=0.0
CAM_L_PX4_YAW_DEG=0.0
CAM_R_PX4_ROLL_DEG=0.0
CAM_R_PX4_PITCH_DEG=0.0
CAM_R_PX4_YAW_DEG=0.0

# Camera PX4 instance isolation. Target PX4 remains instance 0 and keeps the
# existing unnamespaced /fmu topic contract.
PX4_REQUIRED_VERSION=v1.17.0
CAM_L_PX4_MODEL_NAME=left_stereo_camera
CAM_R_PX4_MODEL_NAME=right_stereo_camera
CAM_L_PX4_INSTANCE=1
CAM_R_PX4_INSTANCE=2
CAM_L_PX4_DDS_NAMESPACE=camera_left
CAM_R_PX4_DDS_NAMESPACE=camera_right
PX4_ATTITUDE_LEFT_TOPIC=/camera_left/fmu/out/vehicle_attitude
PX4_ATTITUDE_RIGHT_TOPIC=/camera_right/fmu/out/vehicle_attitude
# Seconds; aligned with the existing camera/GPS diagnostic freshness window.
PX4_ATTITUDE_MAX_AGE_S=2.5
PX4_ATTITUDE_PAIR_SKEW_S=2.5

# Optical attitude experiment defaults. These are ROS launch parameter names.
ATTITUDE_EXPERIMENT_AXES="cam_r_optical_roll_deg cam_r_optical_pitch_deg cam_r_optical_yaw_deg"
ATTITUDE_EXPERIMENT_AXIS_RANGES="cam_r_optical_roll_deg:-1:1:0.05 cam_r_optical_pitch_deg:-1:1:0.05 cam_r_optical_yaw_deg:-1:1:0.05"
ATTITUDE_EXPERIMENT_ANGLE_MIN_DEG=-10
ATTITUDE_EXPERIMENT_ANGLE_MAX_DEG=10
ATTITUDE_EXPERIMENT_ANGLE_STEP_DEG=0.5
ATTITUDE_EXPERIMENT_INCLUDE_NEGATIVE=false
ATTITUDE_EXPERIMENT_QUICK=false
ATTITUDE_OUTPUT_DIR=""

# Target drone spawn and PX4 mission.
DRONE_SPAWN_X_M=0.0
DRONE_SPAWN_Y_M=2000.0
DRONE_SPAWN_Z_M=5.56
DRONE_SPAWN_YAW_DEG=-90.0
DRONE_TAKEOFF_ALTITUDE_M=50.0
DRONE_FORWARD_SPEED_MPS=15.0
DRONE_MOVE_DISTANCE_M=1500.0
DRONE_TARGET_DISTANCE_M=500.0
DRONE_APPROACH_TIMEOUT_S=600.0
DRONE_TAKEOFF_TIMEOUT_S=60.0
DRONE_FIRST_HOVER_S=5.0
DRONE_FINAL_HOVER_S=5.0
DRONE_LAND_DURATION_S=10.0
DRONE_LAND_TIMEOUT_S=90.0
DRONE_SETPOINT_HZ=20.0

# Waypoint mission.
# WAYPOINTS_XY_ALT_M is the flight path used by ./run_px4_waypoint_mission.sh.
# Format: "north,east,altitude_agl_m;north,east,altitude_agl_m;..."
# The script converts altitude_agl_m to PX4 local NED z internally, so 10 m AGL
# becomes z=-10 in the MAVLink setpoint.
WAYPOINTS_XY_ALT_M="0,2000,30;50,1750,30;-50,1500,30;50,1250,30;-50,1000,30;30,750,30;0,500,30"
WAYPOINT_SPEED_MPS="${DRONE_FORWARD_SPEED_MPS:-12.0}"
WAYPOINT_ACCEPTANCE_RADIUS_M=5.0
WAYPOINT_TIMEOUT_S="${DRONE_APPROACH_TIMEOUT_S:-120.0}"
WAYPOINT_TAKEOFF_TIMEOUT_S="${DRONE_TAKEOFF_TIMEOUT_S:-60.0}"
WAYPOINT_HOLD_S="${DRONE_FIRST_HOVER_S:-1.0}"
WAYPOINT_FINAL_HOVER_S="${DRONE_FINAL_HOVER_S:-3.0}"
WAYPOINT_LAND_TIMEOUT_S="${DRONE_LAND_TIMEOUT_S:-90.0}"
WAYPOINT_SETPOINT_HZ="${DRONE_SETPOINT_HZ:-20.0}"
WAYPOINT_LAND_AFTER=true
WAYPOINT_RECORD_LITE=true
# WAYPOINT_RECORD_DIR is only the telemetry output directory. Leave it empty to
# auto-create bags/waypoint_YYYYMMDD_HHMMSS_lite for each run.
WAYPOINT_RECORD_DIR=""

# YOLO runtime.
YOLO_MODEL_PATH="yolov8n_uav.pt"
YOLO_CLASS_NAME=UAV
YOLO_CONFIDENCE=0.10
YOLO_DEVICE=cuda:0
YOLO_TARGET_HZ=20.0
YOLO_IMGSZ=1280
# TensorRT FP16 is the default operational backend.  The engine is generated
# locally from YOLO_MODEL_PATH when absent and is intentionally gitignored:
# it is specific to the installed TensorRT/CUDA/GPU combination.
YOLO_BACKEND=tensorrt
YOLO_TENSORRT_ENGINE_PATH=""
MEASUREMENT_QUEUE_CAPACITY=4096
YOLO_PYTHON=python3
