# Scenario: long-range UAM-scale target with the historical WIRIS 8x setup.
#
# This file intentionally keeps the previous default geometry as a named
# scenario. Use it through:
#   SIM_SCENARIO_CONFIG=uam_far_25m_8x.env ./run_operator_view.sh

SIM_SCENARIO_NAME=uam_far_25m_8x
SIM_TARGET_CLASS=uam
SIM_TARGET_SIZE_M=15.0
SIM_RANGE_MIN_M=500.0
SIM_RANGE_MAX_M=2000.0
SIM_ZOOM_INDEX=8

CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=10.0
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=30.0
CAMERA_CLIP_NEAR_M=0.1
CAMERA_CLIP_FAR_M=4000.0

DRONE_SPAWN_X_M=0.0
DRONE_SPAWN_Y_M=2000.0
DRONE_SPAWN_Z_M=5.56
DRONE_SPAWN_YAW_DEG=-90.0
DRONE_TAKEOFF_ALTITUDE_M=10.0
DRONE_MOVE_DISTANCE_M=1900.0
DRONE_TARGET_DISTANCE_M=200.0
DRONE_FORWARD_SPEED_MPS=15.0
DRONE_APPROACH_TIMEOUT_S=600.0

YOLO_IMGSZ=1280
