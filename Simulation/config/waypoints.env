# PX4 waypoint mission defaults for ./run_px4_waypoint_mission.sh.
#
# Shared drone mission defaults are loaded from config/drone_mission.env before
# this file, so values below can reference DRONE_* variables.
#
# Unit: meters.
# Format: north,east,altitude_agl entries separated by semicolons.
# Positive north/east follow PX4 LOCAL_NED x/y. Altitude is positive above ground.
# In this world the camera approach axis is PX4 local north negative.
# The default below moves along the same camera approach axis as the auto
# mission. It uses DRONE_MOVE_DISTANCE_M for local displacement and
# DRONE_TAKEOFF_ALTITUDE_M for altitude.
# Edit this file, then run ./run_px4_waypoint_mission.sh while PX4 SITL is running.
#
# Command-line options override this file for that run only.
# Example:
#   ./run_px4_waypoint_mission.sh --waypoint -300,0,10 --waypoint -600,0,10
# overrides WAYPOINTS_XY_ALT_M below.

WAYPOINTS_XY_ALT_M="-${DRONE_MOVE_DISTANCE_M:-1900.0},0,${DRONE_TAKEOFF_ALTITUDE_M:-10.0}"

WAYPOINT_SPEED_MPS="${DRONE_FORWARD_SPEED_MPS:-12.0}"
WAYPOINT_ACCEPTANCE_RADIUS_M=5.0
WAYPOINT_TIMEOUT_S="${DRONE_APPROACH_TIMEOUT_S:-120.0}"
WAYPOINT_TAKEOFF_TIMEOUT_S="${DRONE_TAKEOFF_TIMEOUT_S:-60.0}"
WAYPOINT_HOLD_S="${DRONE_FIRST_HOVER_S:-1.0}"
WAYPOINT_FINAL_HOVER_S="${DRONE_FINAL_HOVER_S:-3.0}"
WAYPOINT_LAND_TIMEOUT_S="${DRONE_LAND_TIMEOUT_S:-90.0}"
WAYPOINT_SETPOINT_HZ="${DRONE_SETPOINT_HZ:-20.0}"
WAYPOINT_LAND_AFTER=true

WAYPOINT_RECORD_LITE=true
WAYPOINT_RECORD_DIR=""
