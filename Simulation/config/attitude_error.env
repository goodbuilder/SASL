# Attitude error experiment defaults for ./run_attitude_error_experiment.sh.
#
# Unit: degrees for attitude angles, meters for distances, seconds for durations.
# Command-line options override this file for that run only.
#
# Gazebo/YOLO experiment axes. Space-separated ROS launch parameter names.
ATTITUDE_EXPERIMENT_AXES="right_roll_error_deg right_pitch_error_deg right_yaw_error_deg"
# Optional per-axis ranges. Format: axis:min_deg:max_deg:step_deg, space-separated.
# Axes listed here override the global min/max/step below for that axis.
# Example:
# ATTITUDE_EXPERIMENT_AXIS_RANGES="right_roll_error_deg:-1:1:0.1 right_pitch_error_deg:-1:1:0.1 right_yaw_error_deg:-1:1:0.1"
ATTITUDE_EXPERIMENT_AXIS_RANGES="right_roll_error_deg:-1:1:0.05 right_pitch_error_deg:-1:1:0.05 right_yaw_error_deg:-1:1:0.05"
ATTITUDE_EXPERIMENT_ANGLE_MIN_DEG=-10
ATTITUDE_EXPERIMENT_ANGLE_MAX_DEG=10
ATTITUDE_EXPERIMENT_ANGLE_STEP_DEG=0.5
ATTITUDE_EXPERIMENT_INCLUDE_NEGATIVE=false
ATTITUDE_EXPERIMENT_QUICK=false

ATTITUDE_OUTPUT_DIR=""
