# Camera attitude error defaults for ./run_operator_view.sh.
#
# Unit: degrees.
# Positive/negative signs follow Gazebo SDF roll/pitch/yaw convention.
# Edit this file, then restart ./run_operator_view.sh.
#
# Command-line launch arguments still override this file when both are given.
# Example:
#   ./run_operator_view.sh right_yaw_error_deg:=0.5
# overrides RIGHT_YAW_ERROR_DEG below for that run only.

LEFT_ROLL_ERROR_DEG=0.0
LEFT_PITCH_ERROR_DEG=0.0
LEFT_YAW_ERROR_DEG=0.0

RIGHT_ROLL_ERROR_DEG=0.0
RIGHT_PITCH_ERROR_DEG=0.0
RIGHT_YAW_ERROR_DEG=0.0
