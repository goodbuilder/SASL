# Shared YOLO defaults.
#
# Used by:
#   ./run_operator_view.sh
#   ./run_attitude_error_experiment.sh
#
# Units:
#   confidence: 0.0-1.0
#   target Hz: Hz
#   image size: pixels

YOLO_MODEL_PATH="yolov8n_uav.pt"
YOLO_CLASS_NAME=UAV
YOLO_CONFIDENCE=0.10
YOLO_DEVICE=cuda:0
YOLO_TARGET_HZ=40.0
YOLO_IMGSZ=1280
YOLO_PYTHON=python3
