# Shared stereo camera model defaults.
#
# Used by:
#   ./run_operator_view.sh
#   ./run_attitude_error_experiment.sh
#
# Units:
#   baseline/height/clip: meters
#   FOV: radians
#   WIRIS Enterprise RGB optical zoom reference:
#   Official published range: 30x optical zoom, HFOV 63.7 deg wide to 2.3 deg tele.
#   Public specs give the optical zoom range, not a discrete stop table. The table
#   below treats integer 1x..30x as usable simulation zoom levels and computes:
#     zoom_fov = 2 * atan(tan(63.7 deg / 2) / zoom)
#
#    1x:  63.7000 deg = 1.111774734 rad
#    2x:  34.5114 deg = 0.602337928 rad
#    3x:  23.3987 deg = 0.408384630 rad
#    4x:  17.6560 deg = 0.308155618 rad
#    5x:  14.1651 deg = 0.247227048 rad
#    6x:  11.8226 deg = 0.206343095 rad
#    7x:  10.1432 deg = 0.177031927 rad
#    8x:   8.8807 deg = 0.154997711 rad
#    9x:   7.8973 deg = 0.137833607 rad
#   10x:   7.1097 deg = 0.124087546 rad
#   11x:   6.4648 deg = 0.112831972 rad
#   12x:   5.9271 deg = 0.103446828 rad
#   13x:   5.4719 deg = 0.095501973 rad
#   14x:   5.0815 deg = 0.088689686 rad
#   15x:   4.7432 deg = 0.082784032 rad
#   16x:   4.4470 deg = 0.077615396 rad
#   17x:   4.1857 deg = 0.073053971 rad
#   18x:   3.9533 deg = 0.068998731 rad
#   19x:   3.7454 deg = 0.065369877 rad
#   20x:   3.5583 deg = 0.062103539 rad
#   21x:   3.3889 deg = 0.059147995 rad
#   22x:   3.2350 deg = 0.056460912 rad
#   23x:   3.0944 deg = 0.054007310 rad
#   24x:   2.9655 deg = 0.051758031 rad
#   25x:   2.8469 deg = 0.049688580 rad
#   26x:   2.7375 deg = 0.047778222 rad
#   27x:   2.6361 deg = 0.046009295 rad
#   28x:   2.5420 deg = 0.044366654 rad
#   29x:   2.4544 deg = 0.042837246 rad
#   30x:   2.3726 deg = 0.041409753 rad
#   resolution: pixels
#   update rate: Hz

CAMERA_BASELINE_M=25.0
CAMERA_HEIGHT_M=10.0
CAMERA_HORIZONTAL_FOV_RAD=0.154997710698
CAMERA_IMAGE_WIDTH_PX=1280
CAMERA_IMAGE_HEIGHT_PX=720
CAMERA_UPDATE_RATE_HZ=20.0
CAMERA_CLIP_NEAR_M=0.1
CAMERA_CLIP_FAR_M=4000.0
