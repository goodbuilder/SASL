# Drone spawn and PX4 auto mission defaults.
#
# Used by:
#   ./run_operator_view.sh
#   ./run_auto_mission.sh
#   ./run_px4_waypoint_mission.sh
#   ./run_attitude_error_experiment.sh
#
# Command-line options and explicit launch args override this file for that run.
#
# Units:
#   position/distance/altitude: meters
#   speed: meters per second
#   yaw: degrees
#   timeout/hover: seconds

# Gazebo spawn pose for the x500_15m target model.
# The default puts the drone 2000 m in front of the stereo cameras.
DRONE_SPAWN_X_M=0.0
DRONE_SPAWN_Y_M=2000.0
DRONE_SPAWN_Z_M=5.56
DRONE_SPAWN_YAW_DEG=-90.0

# PX4 offboard auto mission defaults.
DRONE_TAKEOFF_ALTITUDE_M=10.0
DRONE_FORWARD_SPEED_MPS=15.0
DRONE_MOVE_DISTANCE_M=1500.0
DRONE_TARGET_DISTANCE_M=500.0
DRONE_APPROACH_TIMEOUT_S=600.0
DRONE_TAKEOFF_TIMEOUT_S=60.0
DRONE_FIRST_HOVER_S=5.0
DRONE_FINAL_HOVER_S=5.0
DRONE_LAND_DURATION_S=10.0
DRONE_LAND_TIMEOUT_S=90.0
DRONE_SETPOINT_HZ=20.0
